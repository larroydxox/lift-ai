# Copie para `.env` (local) e preencha. Na Vercel: Settings > Environment Variables.
# No Vite, variáveis expostas ao browser PRECISAM do prefixo VITE_.

# Supabase — Project Settings > API
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Claude API — SECRETA. Nunca use com prefixo VITE_ (vazaria no bundle).
# Use só em Serverless Function (ex: /api/parse). Sem prefixo VITE_.
CLAUDE_API_KEY=sk-ant-...
