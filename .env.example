# Copie este arquivo para `.env` e preencha com suas chaves reais.
# NUNCA faça commit do `.env` (ele está no .gitignore).

# Supabase — pegue em https://supabase.com > Project Settings > API
REACT_APP_SUPABASE_URL=https://xxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Claude API — pegue em https://console.anthropic.com
# Atenção: só use a Claude API a partir de um backend/edge function,
# nunca embutida no app cliente (a chave vazaria).
CLAUDE_API_KEY=sk-ant-...
